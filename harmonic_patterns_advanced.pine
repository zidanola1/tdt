//@version=5
indicator(title='Advanced Harmonic Patterns with Flexible Ratios', shorttitle='Harmonics Pro', overlay=true, max_lines_count=500, max_labels_count=500)

// ═══════════════════════════════════════════════════════════════════════════════
// ADVANCED HARMONIC PATTERN DETECTOR
// Uses flexible ratios with intelligent scoring system
// Includes ICT confluence and dynamic tolerance
// ═══════════════════════════════════════════════════════════════════════════════

// ─────────────────────────────────────────────────────────────────────────────
// INPUTS
// ─────────────────────────────────────────────────────────────────────────────

// Pattern Detection Settings
zigzagDepth = input.int(12, title='ZigZag Depth', minval=1, group='Detection Settings')
zigzagDeviation = input.int(5, title='ZigZag Deviation (%)', minval=1, group='Detection Settings')
baseDetectMargin = input.float(8.0, title='Base Detection Margin (%)', minval=1, maxval=20, group='Detection Settings')
useDynamicTolerance = input.bool(true, title='Use Dynamic Tolerance (ATR-based)', group='Detection Settings')
atrPeriod = input.int(50, title='ATR Period for Dynamic Tolerance', minval=10, group='Detection Settings')
minPatternScore = input.float(0.75, title='Minimum Pattern Quality Score', minval=0.5, maxval=1.0, step=0.05, group='Detection Settings')

// Pattern Type Toggles
showGartley = input.bool(true, title='Show Gartley (222)', group='Pattern Types')
showBat = input.bool(true, title='Show Bat', group='Pattern Types')
showButterfly = input.bool(true, title='Show Butterfly', group='Pattern Types')
showCrab = input.bool(true, title='Show Crab', group='Pattern Types')
showShark = input.bool(true, title='Show Shark', group='Pattern Types')
showCypher = input.bool(true, title='Show Cypher', group='Pattern Types')

// Filters
useTrendFilter = input.bool(true, title='Enable Trend Filter', group='Filters')
trendMaPeriod = input.int(50, title='Trend MA Period', minval=10, group='Filters')
useVolFilter = input.bool(false, title='Enable Volume Filter', group='Filters')
volMaPeriod = input.int(20, title='Volume MA Period', minval=5, group='Filters')
showOnlyBest = input.bool(true, title='Show Only Best Pattern Per Direction', group='Filters')

// ICT Confluence
useIctConfluence = input.bool(true, title='Enable ICT Confluence Markers', group='ICT Settings')
showFvgZones = input.bool(true, title='Show Fair Value Gaps at D-Point', group='ICT Settings')
showObZones = input.bool(true, title='Show Order Blocks near D-Point', group='ICT Settings')

// Visual Settings
showPatternLabels = input.bool(true, title='Show Pattern Labels', group='Visual')
showPatternLines = input.bool(true, title='Show Pattern Lines', group='Visual')
showRatioLabels = input.bool(true, title='Show Ratio Labels', group='Visual')
showQualityScore = input.bool(true, title='Show Quality Score', group='Visual')

// ─────────────────────────────────────────────────────────────────────────────
// DYNAMIC TOLERANCE CALCULATION
// ─────────────────────────────────────────────────────────────────────────────

atrValue = ta.atr(atrPeriod)
avgPrice = (high + low) / 2
atrPercent = (atrValue / avgPrice) * 100
dynamicMargin = useDynamicTolerance ? math.max(baseDetectMargin * 0.5, math.min(baseDetectMargin * 1.5, atrPercent * 2)) : baseDetectMargin

// ─────────────────────────────────────────────────────────────────────────────
// ZIGZAG CALCULATION (Non-repainting version)
// ─────────────────────────────────────────────────────────────────────────────

var float[] zigzagPrices = array.new_float(0)
var int[] zigzagBars = array.new_int(0)
var int[] zigzagTypes = array.new_int(0)  // 1 = high, -1 = low

// Simple pivot detection
pivotHigh = ta.pivothigh(high, zigzagDepth, zigzagDepth)
pivotLow = ta.pivotlow(low, zigzagDepth, zigzagDepth)

if not na(pivotHigh)
    array.push(zigzagPrices, pivotHigh)
    array.push(zigzagBars, bar_index - zigzagDepth)
    array.push(zigzagTypes, 1)
    if array.size(zigzagPrices) > 10
        array.shift(zigzagPrices)
        array.shift(zigzagBars)
        array.shift(zigzagTypes)

if not na(pivotLow)
    array.push(zigzagPrices, pivotLow)
    array.push(zigzagBars, bar_index - zigzagDepth)
    array.push(zigzagTypes, -1)
    if array.size(zigzagPrices) > 10
        array.shift(zigzagPrices)
        array.shift(zigzagBars)
        array.shift(zigzagTypes)

// ─────────────────────────────────────────────────────────────────────────────
// RATIO MATCHING WITH SCORING
// ─────────────────────────────────────────────────────────────────────────────

// Calculate match score for a ratio (returns 0-1)
calcRatioScore(measuredRatio, targetRatio, tolerance) =>
    deviation = math.abs(measuredRatio - targetRatio) / targetRatio
    maxDeviation = tolerance / 100
    score = deviation <= maxDeviation ? 1 - (deviation / maxDeviation) : 0.0
    score

// Check if ratio matches with score
matchRatio(measuredRatio, targetRatio, tolerance) =>
    lowerBound = targetRatio * (1 - tolerance / 100)
    upperBound = targetRatio * (1 + tolerance / 100)
    inRange = measuredRatio >= lowerBound and measuredRatio <= upperBound
    score = calcRatioScore(measuredRatio, targetRatio, tolerance)
    [inRange, score]

// ─────────────────────────────────────────────────────────────────────────────
// PATTERN DEFINITIONS WITH FLEXIBLE RATIOS
// ─────────────────────────────────────────────────────────────────────────────

type PatternRatios
    string name
    float abRatioMin
    float abRatioMax
    float bcRatioMin
    float bcRatioMax
    float cdRatioMin
    float cdRatioMax
    float adRatioMin
    float adRatioMax
    color bullColor
    color bearColor

// Define pattern specifications
gartleyRatios = PatternRatios.new('Gartley', 0.618, 0.618, 0.382, 0.886, 1.13, 1.618, 0.786, 0.786, color.new(color.green, 30), color.new(color.red, 30))
batRatios = PatternRatios.new('Bat', 0.382, 0.50, 0.382, 0.886, 1.618, 2.618, 0.886, 0.886, color.new(color.blue, 30), color.new(color.orange, 30))
butterflyRatios = PatternRatios.new('Butterfly', 0.786, 0.786, 0.382, 0.886, 1.618, 2.24, 1.27, 1.618, color.new(color.purple, 30), color.new(color.maroon, 30))
crabRatios = PatternRatios.new('Crab', 0.382, 0.618, 0.382, 0.886, 2.24, 3.618, 1.618, 1.618, color.new(color.aqua, 30), color.new(color.fuchsia, 30))
sharkRatios = PatternRatios.new('Shark', 0.382, 0.618, 1.13, 1.618, 1.618, 2.24, 0.886, 1.13, color.new(color.lime, 30), color.new(color.navy, 30))
cypherRatios = PatternRatios.new('Cypher', 0.382, 0.618, 1.13, 1.414, 0.618, 0.786, 0.786, 0.786, color.new(color.teal, 30), color.new(color.olive, 30))

// ─────────────────────────────────────────────────────────────────────────────
// PATTERN DETECTION FUNCTION
// ─────────────────────────────────────────────────────────────────────────────

type PatternResult
    bool found
    string name
    float scoreAB
    float scoreBC
    float scoreCD
    float scoreAD
    float totalScore
    float xPrice
    float aPrice
    float bPrice
    float cPrice
    float dPrice
    int xBar
    int aBar
    int bBar
    int cBar
    int dBar
    bool isBullish
    color patternColor

detectPattern(PatternRatios ratios, float X, float A, float B, float C, float D, bool isBullish, int xBar, int aBar, int bBar, int cBar, int dBar) =>
    // Calculate leg lengths
    xa = math.abs(A - X)
    ab = math.abs(B - A)
    bc = math.abs(C - B)
    cd = math.abs(D - C)
    ad = math.abs(D - A)
    
    // Calculate ratios
    abRatio = ab / xa
    bcRatio = bc / ab
    cdRatio = cd / bc
    adRatio = ad / xa
    
    // Get target ratios (use average of min/max for scoring)
    targetAB = (ratios.abRatioMin + ratios.abRatioMax) / 2
    targetBC = (ratios.bcRatioMin + ratios.bcRatioMax) / 2
    targetCD = (ratios.cdRatioMin + ratios.cdRatioMax) / 2
    targetAD = (ratios.adRatioMin + ratios.adRatioMax) / 2
    
    // Calculate scores
    [matchAB, scoreAB] = matchRatio(abRatio, targetAB, dynamicMargin)
    [matchBC, scoreBC] = matchRatio(bcRatio, targetBC, dynamicMargin)
    [matchCD, scoreCD] = matchRatio(cdRatio, targetCD, dynamicMargin)
    [matchAD, scoreAD] = matchRatio(adRatio, targetAD, dynamicMargin * 0.8)  // AD is critical, tighter tolerance
    
    // Calculate total quality score (weighted - AD is most important)
    totalScore = (scoreAB * 0.2 + scoreBC * 0.2 + scoreCD * 0.25 + scoreAD * 0.35)
    
    // Pattern is valid if all ratios match AND total score meets minimum
    patternValid = matchAB and matchBC and matchCD and matchAD and totalScore >= minPatternScore
    
    result = PatternResult.new(
         found = patternValid,
         name = ratios.name,
         scoreAB = scoreAB,
         scoreBC = scoreBC,
         scoreCD = scoreCD,
         scoreAD = scoreAD,
         totalScore = totalScore,
         xPrice = X,
         aPrice = A,
         bPrice = B,
         cPrice = C,
         dPrice = D,
         xBar = xBar,
         aBar = aBar,
         bBar = bBar,
         cBar = cBar,
         dBar = dBar,
         isBullish = isBullish,
         patternColor = isBullish ? ratios.bullColor : ratios.bearColor
     )
    result

// ─────────────────────────────────────────────────────────────────────────────
// TREND FILTER
// ─────────────────────────────────────────────────────────────────────────────

trendMa = ta.sma(close, trendMaPeriod)
isBullTrend = close > trendMa
isBearTrend = close < trendMa

// ─────────────────────────────────────────────────────────────────────────────
// VOLUME FILTER
// ─────────────────────────────────────────────────────────────────────────────

volMa = ta.sma(volume, volMaPeriod)
isHighVolume = volume > volMa

// ─────────────────────────────────────────────────────────────────────────────
// MAIN PATTERN DETECTION LOGIC
// ─────────────────────────────────────────────────────────────────────────────

var PatternResult bestBullishPattern = na
var PatternResult bestBearishPattern = na

if array.size(zigzagPrices) >= 5
    // Get last 5 pivots
    D = array.get(zigzagPrices, array.size(zigzagPrices) - 1)
    C = array.get(zigzagPrices, array.size(zigzagPrices) - 2)
    B = array.get(zigzagPrices, array.size(zigzagPrices) - 3)
    A = array.get(zigzagPrices, array.size(zigzagPrices) - 4)
    X = array.get(zigzagPrices, array.size(zigzagPrices) - 5)
    
    dBar = array.get(zigzagBars, array.size(zigzagBars) - 1)
    cBar = array.get(zigzagBars, array.size(zigzagBars) - 2)
    bBar = array.get(zigzagBars, array.size(zigzagBars) - 3)
    aBar = array.get(zigzagBars, array.size(zigzagBars) - 4)
    xBar = array.get(zigzagBars, array.size(zigzagBars) - 5)
    
    // Determine if pattern is bullish or bearish
    // Bullish: D is low, C is high, B is low, A is high, X is low
    // Bearish: D is high, C is low, B is high, A is low, X is high
    isBullish = D < C and C > B and B < A and A > X
    isBearish = D > C and C < B and B > A and A < X
    
    if isBullish or isBearish
        // Check trend filter
        trendOk = not useTrendFilter or (isBullish and isBearTrend) or (isBearish and isBullTrend)
        
        // Check volume filter
        volOk = not useVolFilter or isHighVolume
        
        if trendOk and volOk
            // Test all patterns
            patterns = array.new<PatternRatios>()
            if showGartley
                array.push(patterns, gartleyRatios)
            if showBat
                array.push(patterns, batRatios)
            if showButterfly
                array.push(patterns, butterflyRatios)
            if showCrab
                array.push(patterns, crabRatios)
            if showShark
                array.push(patterns, sharkRatios)
            if showCypher
                array.push(patterns, cypherRatios)
            
            // Find best matching pattern
            for patternRatios in patterns
                result = detectPattern(patternRatios, X, A, B, C, D, isBullish, xBar, aBar, bBar, cBar, dBar)
                
                if result.found
                    if isBullish
                        if na(bestBullishPattern) or result.totalScore > bestBullishPattern.totalScore
                            bestBullishPattern := result
                    else
                        if na(bestBearishPattern) or result.totalScore > bestBearishPattern.totalScore
                            bestBearishPattern := result

// ─────────────────────────────────────────────────────────────────────────────
// VISUALIZATION
// ─────────────────────────────────────────────────────────────────────────────

drawPattern(PatternResult pattern) =>
    if not na(pattern) and pattern.found
        if showPatternLines
            line.new(pattern.xBar, pattern.xPrice, pattern.aBar, pattern.aPrice, color=pattern.patternColor, width=2)
            line.new(pattern.aBar, pattern.aPrice, pattern.bBar, pattern.bPrice, color=pattern.patternColor, width=2)
            line.new(pattern.bBar, pattern.bPrice, pattern.cBar, pattern.cPrice, color=pattern.patternColor, width=2)
            line.new(pattern.cBar, pattern.cPrice, pattern.dBar, pattern.dPrice, color=pattern.patternColor, width=2)
            line.new(pattern.xBar, pattern.xPrice, pattern.dBar, pattern.dPrice, color=pattern.patternColor, width=1, style=line.style_dashed)
        
        if showPatternLabels
            labelText = pattern.name + (showQualityScore ? '\nQ: ' + str.tostring(math.round(pattern.totalScore * 100)) + '%' : '')
            label.new(pattern.dBar, pattern.dPrice, text=labelText, 
                     style=pattern.isBullish ? label.style_label_up : label.style_label_down,
                     color=pattern.patternColor, textcolor=color.white, size=size.normal)
        
        if showRatioLabels
            label.new(pattern.bBar, (pattern.aPrice + pattern.bPrice) / 2, text='AB: ' + str.tostring(math.round(pattern.scoreAB * 100)) + '%', 
                     style=label.style_none, textcolor=pattern.patternColor, size=size.tiny)
            label.new(pattern.cBar, (pattern.bPrice + pattern.cPrice) / 2, text='BC: ' + str.tostring(math.round(pattern.scoreBC * 100)) + '%',
                     style=label.style_none, textcolor=pattern.patternColor, size=size.tiny)
            label.new(pattern.dBar, (pattern.cPrice + pattern.dPrice) / 2, text='CD: ' + str.tostring(math.round(pattern.scoreCD * 100)) + '%',
                     style=label.style_none, textcolor=pattern.patternColor, size=size.tiny)

// Draw patterns
if showOnlyBest
    if not na(bestBullishPattern)
        drawPattern(bestBullishPattern)
    if not na(bestBearishPattern)
        drawPattern(bestBearishPattern)

// ─────────────────────────────────────────────────────────────────────────────
// ICT CONFLUENCE DETECTION
// ─────────────────────────────────────────────────────────────────────────────

// Fair Value Gap Detection
detectFvg(lookback) =>
    bullishFvg = low > high[2]
    bearishFvg = high < low[2]
    [bullishFvg, bearishFvg]

[isBullFvg, isBearFvg] = detectFvg(0)

// Order Block Detection (simplified)
detectOrderBlock() =>
    bullOb = close[1] < open[1] and close > open and close > high[1]  // Bullish OB
    bearOb = close[1] > open[1] and close < open and close < low[1]   // Bearish OB
    [bullOb, bearOb]

[isBullOb, isBearOb] = detectOrderBlock()

// Plot ICT confluence markers (must be at global scope in Pine Script)
// FVG zones
if useIctConfluence and showFvgZones and isBullFvg
    box.new(bar_index - 1, low[2], bar_index, high, bgcolor=color.new(color.green, 90), border_color=color.new(color.green, 50))
if useIctConfluence and showFvgZones and isBearFvg
    box.new(bar_index - 1, low, bar_index, high[2], bgcolor=color.new(color.red, 90), border_color=color.new(color.red, 50))

// Order Block markers
plotshape(useIctConfluence and showObZones and isBullOb, style=shape.triangleup, location=location.belowbar, color=color.new(color.lime, 0), size=size.tiny, title='Bull OB')
plotshape(useIctConfluence and showObZones and isBearOb, style=shape.triangledown, location=location.abovebar, color=color.new(color.red, 0), size=size.tiny, title='Bear OB')

// ─────────────────────────────────────────────────────────────────────────────
// ALERTS
// ─────────────────────────────────────────────────────────────────────────────

// Generic alert conditions (message must be const string in Pine Script)
alertcondition(not na(bestBullishPattern) and bestBullishPattern.found, 
              title='Bullish Harmonic Pattern', 
              message='{{ticker}} {{interval}}: Bullish harmonic pattern detected at {{close}}')

alertcondition(not na(bestBearishPattern) and bestBearishPattern.found, 
              title='Bearish Harmonic Pattern',
              message='{{ticker}} {{interval}}: Bearish harmonic pattern detected at {{close}}')

// Specific pattern alerts
alertcondition(not na(bestBullishPattern) and bestBullishPattern.found and bestBullishPattern.name == 'Gartley',
              title='Bullish Gartley Pattern',
              message='{{ticker}}: Bullish Gartley pattern detected')

alertcondition(not na(bestBearishPattern) and bestBearishPattern.found and bestBearishPattern.name == 'Gartley',
              title='Bearish Gartley Pattern',
              message='{{ticker}}: Bearish Gartley pattern detected')

alertcondition(not na(bestBullishPattern) and bestBullishPattern.found and bestBullishPattern.name == 'Bat',
              title='Bullish Bat Pattern',
              message='{{ticker}}: Bullish Bat pattern detected')

alertcondition(not na(bestBearishPattern) and bestBearishPattern.found and bestBearishPattern.name == 'Bat',
              title='Bearish Bat Pattern',
              message='{{ticker}}: Bearish Bat pattern detected')

alertcondition(not na(bestBullishPattern) and bestBullishPattern.found and bestBullishPattern.name == 'Butterfly',
              title='Bullish Butterfly Pattern',
              message='{{ticker}}: Bullish Butterfly pattern detected')

alertcondition(not na(bestBearishPattern) and bestBearishPattern.found and bestBearishPattern.name == 'Butterfly',
              title='Bearish Butterfly Pattern',
              message='{{ticker}}: Bearish Butterfly pattern detected')

alertcondition(not na(bestBullishPattern) and bestBullishPattern.found and bestBullishPattern.name == 'Crab',
              title='Bullish Crab Pattern',
              message='{{ticker}}: Bullish Crab pattern detected')

alertcondition(not na(bestBearishPattern) and bestBearishPattern.found and bestBearishPattern.name == 'Crab',
              title='Bearish Crab Pattern',
              message='{{ticker}}: Bearish Crab pattern detected')

alertcondition(not na(bestBullishPattern) and bestBullishPattern.found and bestBullishPattern.name == 'Shark',
              title='Bullish Shark Pattern',
              message='{{ticker}}: Bullish Shark pattern detected')

alertcondition(not na(bestBearishPattern) and bestBearishPattern.found and bestBearishPattern.name == 'Shark',
              title='Bearish Shark Pattern',
              message='{{ticker}}: Bearish Shark pattern detected')

alertcondition(not na(bestBullishPattern) and bestBullishPattern.found and bestBullishPattern.name == 'Cypher',
              title='Bullish Cypher Pattern',
              message='{{ticker}}: Bullish Cypher pattern detected')

alertcondition(not na(bestBearishPattern) and bestBearishPattern.found and bestBearishPattern.name == 'Cypher',
              title='Bearish Cypher Pattern',
              message='{{ticker}}: Bearish Cypher pattern detected')

// ─────────────────────────────────────────────────────────────────────────────
// INFO DISPLAY
// ─────────────────────────────────────────────────────────────────────────────

var table infoTable = table.new(position.top_right, 2, 8, bgcolor=color.new(color.black, 80), border_width=1)

if barstate.islast
    table.cell(infoTable, 0, 0, 'Tolerance:', text_color=color.white, text_size=size.small)
    table.cell(infoTable, 1, 0, str.tostring(math.round(dynamicMargin * 10) / 10) + '%', text_color=color.yellow, text_size=size.small)
    table.cell(infoTable, 0, 1, 'Min Score:', text_color=color.white, text_size=size.small)
    table.cell(infoTable, 1, 1, str.tostring(math.round(minPatternScore * 100)) + '%', text_color=color.yellow, text_size=size.small)
    table.cell(infoTable, 0, 2, 'Trend Filter:', text_color=color.white, text_size=size.small)
    table.cell(infoTable, 1, 2, useTrendFilter ? 'ON' : 'OFF', text_color=useTrendFilter ? color.lime : color.gray, text_size=size.small)
    table.cell(infoTable, 0, 3, 'ICT Filter:', text_color=color.white, text_size=size.small)
    table.cell(infoTable, 1, 3, useIctConfluence ? 'ON' : 'OFF', text_color=useIctConfluence ? color.lime : color.gray, text_size=size.small)

// Plot trend MA
plot(useTrendFilter ? trendMa : na, title='Trend MA', color=color.new(color.yellow, 50), linewidth=1)

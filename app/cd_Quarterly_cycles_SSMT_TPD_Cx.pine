        [bear13,bear03,bull13,bull03] = f_ssmt(hmax2,hmax1,hmax,lmin2,lmin1,lmin,
         dhmax2,dhmax1,dhmax,dlmin2,dlmin1,dlmin,array.get(arrstart,1),show_candles90,

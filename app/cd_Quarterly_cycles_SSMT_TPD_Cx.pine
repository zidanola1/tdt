    get_range(is_week4, "Weekly R -Thursday-", weekly_clr, show_labelsW,1)
    get_range(is_week5, "Weekly x -Friday-", color.new(weekly_clr,50), show_labelsW,1)
    if tipo == "crypto"
        get_range(is_week6, "Weekly x -Saturday-", color.new(weekly_clr,50), show_labelsW,1)  
        get_range(is_week7, "Weekly x -Sunday-", color.new(weekly_clr,50), show_labelsW,1)
if show_cyclesW and tf_okW and showaslines  and tf_okW_V
    if newW
        f_asline(3)

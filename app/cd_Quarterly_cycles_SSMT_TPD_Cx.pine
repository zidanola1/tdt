//Daily cycle (anchored at 17:00 NY, 6-hour blocks)
sesq_txt = 'Daily A' , sesq_css = daily_clr, txtq = "A", is_sesq = math.sign(nz(time(tf, '1700-2300', tz))) 
sesr_txt = 'Daily M' , sesr_css = daily_clr, txtr = "M", is_sesr = math.sign(nz(time(tf, '2300-0500', tz))) 
sess_txt = 'Daily D' , sess_css = daily_clr, txts = "D", is_sess = math.sign(nz(time(tf, '0500-1100', tz))) 
sest_txt = 'Daily R' , sest_css = daily_clr, txtt = "X", is_sest = math.sign(nz(time(tf, '1100-1700', tz))) 

//Weekly cycle
var trueday = 2
var newday = false
if is_sesq[1] == 0 and is_sesq == 1 and newday == false 
    trueday :=  
     day_week == 1 ? 2 :  
     day_week == 2 ? 3 :
     day_week == 3 ? 4 :
     day_week == 4 ? 5 :
     day_week == 5 ? 6 : 
     day_week == 6 ? 7 : 1 //
    newday := true
if (is_sesq[1] == 1 and is_sesq == 1)   
    newday := false

is_week1 = trueday  == 2 ? 1 : 0//monday
is_week2 = trueday  == 3 ? 1 : 0
is_week3 = trueday  == 4 ? 1 : 0
is_week4 = trueday  == 5 ? 1 : 0

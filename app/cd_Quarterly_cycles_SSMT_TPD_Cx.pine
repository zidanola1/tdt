        [bear1m3,bear0m3,bull1m3,bull0m3] = f_ssmt(hmax2m,hmax1m,hmaxm,lmin2m,lmin1m,lminm,
         dhmax2m,dhmax1m,dhmaxm,dlmin2m,dlmin1m,dlminm,array.get(arrstart,0),show_candlesmic,
         hmaxmt,lminmt,hmaxt1m,lmint1m,tf_ok_mic,val_sesm,show_smtm, smtm_clr,true,1,yh0,yl0 , tf_ok_mic_V)//

////////////////////////////////////////////
f_start()

////////////////////////////////////////////////////////////////////////////////////////////////////////////////
csym  = sym
tsym2 = sym
tsym3 = sym
///////////////
arr_triadA = array.from(str.contains(sym,st1),str.contains(sym,st2),str.contains(sym,st3))
arr_triadB = array.from(str.contains(sym,st4),str.contains(sym,st5),str.contains(sym,st6))
arr_triadC = array.from(str.contains(sym,st7),str.contains(sym,st8),str.contains(sym,st9))
triad_ok   = (array.some(arr_triadA) and tr1A) or (array.some(arr_triadB) and tr1B) or (array.some(arr_triadC) and tr1C)

if triad_ok //and looksmt
    if showsmt1
        tsym2 := str.contains(sym,st1) ? st2 : str.contains(sym,st2) ? st1 : str.contains(sym,st3) ? st1 : sym
    if showsmt2
        tsym3 := str.contains(sym,st1) ? st3 : str.contains(sym,st2) ? st3 : str.contains(sym,st3) ? st2 : sym
    if showsmt1    
        tsym2 := str.contains(sym,st4) ? st5 : str.contains(sym,st5) ? st4 : str.contains(sym,st6) ? st4 : tsym2    
    if showsmt2
        tsym3 := str.contains(sym,st4) ? st6 : str.contains(sym,st5) ? st6 : str.contains(sym,st6) ? st5 : tsym3
    if showsmt1
        tsym2 := str.contains(sym,st7) ? st8 : str.contains(sym,st8) ? st7 : str.contains(sym,st9) ? st7 : tsym2    
    if showsmt2    
        tsym3 := str.contains(sym,st7) ? st9 : str.contains(sym,st8) ? st9 : str.contains(sym,st9) ? st8 : tsym3
    csym  := syminfo.type == "futures" ? (ticker.modify(tsym2,session = syminfo.session,backadjustment=badj ? backadjustment.on:backadjustment.off) ) :tsym2
    tsym3 := syminfo.type == "futures" ? (ticker.modify(tsym3,session = syminfo.session,backadjustment=badj ? backadjustment.on:backadjustment.off) ) :tsym3

if not triad_ok
    csym  := str.contains(sym,s1) and ok1 ? s2 : str.contains(sym,s2)and ok2 ? s1 : csym
    csym  := str.contains(sym,s3) and ok2 ? s4 : str.contains(sym,s4)and ok2 ? s3 : csym
    csym  := str.contains(sym,s5) and ok3 ? s6 : str.contains(sym,s6)and ok3 ? s5 : csym
    csym  := str.contains(sym,s7) and ok4 ? s8 : str.contains(sym,s8)and ok4 ? s7 : csym 
    csym  := syminfo.type == "futures" ? (ticker.modify(csym,session = syminfo.session,backadjustment=badj ? backadjustment.on:backadjustment.off) ) :csym //new

dyad_ok = sym != csym

[xc0,xo0,xh0,xl0,xt0,xatr]=request.security(csym,tf,[close,open,high,low,time,ta.atr(20)],lookahead = barmerge.lookahead_on,ignore_invalid_symbol = true)
ssmt_pair  = str.tostring(syminfo.ticker(csym)) 
txt_lbl = triad_ok ? ssmt_pair + " + "+str.tostring(syminfo.ticker(tsym3)) : ssmt_pair 
ssmt_label = 'SSMT --> '+ txt_lbl +'\n' 
ssmt_label := ssmt_label + dot_line + '\n'

[yc0,yo0,yh0,yl0,yt0,yatr]=request.security( tsym3,tf,[close,open,high,low,time,ta.atr(20)],lookahead = barmerge.lookahead_on,ignore_invalid_symbol = true)

////////////////////////////////////////////////
f_main_process(_tf_ok,_tf_ok_V, _val_ses, op,cls,hi,lo,ti,show_cand,cyc_txt,arr_sesy,arr_sesz,arrst)=>
    var o0     = op 
    var hmax   = hi , var hmax1 = hi , var hmax2 = hi
    var lmin   = lo , var lmin1 = lo , var lmin2 = lo
    var t0     = ti
    var t1     = ti
    var txt0   = ""
    var hmaxt  = ti,  var lmint   = ti
    var hmaxt1 = ti,  var lmint1  = ti
    var clsmax  = math.max(cls,op), var clsmaxt = ti  , var clsmin  = math.min(cls,op) , var clsmint =  ti
    var clsmax1 = math.max(cls,op), var clsmaxt1 = ti , var clsmin1 = math.min(cls,op) , var clsmint1 = ti
    var arr_h = array.new_float(),var arr_l = array.new_float()
    var arr_o = array.new_float(),var arr_c = array.new_float()
    var arr_t = array.new_string()    

    if _tf_ok
        if _val_ses  !=  _val_ses[1]
            o0    := op
            hmax  := hi
            lmin  := lo
            t0    := ti
            hmaxt := ti
            lmint := ti
            clsmax  := math.max(cls,op)
            clsmaxt := ti
            clsmin  := math.min(cls,op)
            clsmint := ti 

    if _val_ses == _val_ses[1]
        if hi >= hmax
            hmax  := hi
            hmaxt := ti
        if lo <= lmin
            lmin  := lo
            lmint := ti

        if math.max(cls,op) >= clsmax 
            clsmax := math.max(cls,op)
            clsmaxt:= ti
        if math.min(cls,op) <= clsmin 
            clsmin := math.min(cls,op)
            clsmint:= ti 

    c0 = cls
    txt0 := array.get(arr_sesy,_val_ses)
    txtz  = array.get(arr_sesz,_val_ses)
    if _val_ses  !=  _val_ses[1]
        add_to_array(arr_h,hmax[1])
        add_to_array(arr_l,lmin[1])        
        add_to_array(arr_o,o0[1])
        add_to_array(arr_c,cls[1])
        add_to_array(arr_t,txt0[1])
        hmax1 := hmax[1]
        lmin1 := lmin[1]
        hmax2 := hmax1[1]
        lmin2 := lmin1[1]                
        hmaxt1 := hmaxt[1]
        lmint1 := lmint[1]        
        t1 := t0[1]
        clsmax1  := clsmax[1]
        clsmaxt1 := clsmaxt[1]
        clsmin1  := clsmin[1]
        clsmint1 := clsmint[1]
    labels_high = array.max(arr_h)
    dt  =  t0 +(t0 - t1) 
    rmt  = RemainingTime(dt)
    rmttxt=  not str.contains(syminfo.tickerid,"replay") ? rmt : "replay mode"
    st90 = array.get(arrstart,arrst)
    if show_cand and _tf_ok  and _tf_ok_V 
        f_plot_candle(c0,o0,hmax,lmin,st90,0,txt0)
    if array.size(arr_h) == num_candles-1 and show_cand and _tf_ok and _tf_ok_V //_c,_o,_h,_l,start,i,txt
        f_plot_candle(array.get(arr_c,0 ),array.get(arr_o,0 ),array.get(arr_h,0 ),array.get(arr_l,0 ),st90,1,array.get(arr_t,0 ))
        f_plot_candle(array.get(arr_c,1 ),array.get(arr_o,1 ),array.get(arr_h,1 ),array.get(arr_l,1 ),st90,2,array.get(arr_t,1 ))
        f_plot_candle(array.get(arr_c,2 ),array.get(arr_o,2 ),array.get(arr_h,2 ),array.get(arr_l,2 ),st90,3,array.get(arr_t,2 ))
        f_plot_candle(array.get(arr_c,3 ),array.get(arr_o,3 ),array.get(arr_h,3 ),array.get(arr_l,3 ),st90,4,array.get(arr_t,3 ))
        //f_plot_candle(array.get(arr_c,4 ),array.get(arr_o,4 ),array.get(arr_h,4 ),array.get(arr_l,4 ),st90,5,array.get(arr_t,4 ))
        if show_labelcnd
            lbl0 = label.new(bar_index+dx+st90+10,labels_high + 3 * ta.atr(20)  , yloc=yloc.price ,  text= cyc_txt+'\n'+str.tostring(txtz)+'\n'+str.tostring(rmttxt),xloc=xloc.bar_index,color=color.new(color.teal,0),style=label.style_label_center,textcolor = color.white,size=size.small)//,text_formatting = text.format_bold )
            label.delete(lbl0[1])
   
    [hmaxt,lmint,hmax2, lmin2,hmax1,lmin1,hmax,lmin,hmaxt1,lmint1,clsmax,clsmax1,clsmaxt1,clsmin,clsmin1,clsmint1,clsmaxt,clsmint,o0,txt0] 
/////////////////////////////////////////////////////////////////////// 
[hmaxt,lmint,hmax2,lmin2,hmax1,lmin1,hmax,lmin,hmaxt1,lmint1,clsmax,clsmax1,clsmaxt1,clsmin,clsmin1,clsmint1,clsmaxt,clsmint,o0,txt0]                                = f_main_process(tf_ok,tf_ok_V, val_ses,open,close,high,low,time,show_candles90," 90m ",arr_sesy,arr_sesz,1)
[chmaxt,clmint,chmax2,clmin2,chmax1,clmin1,chmax,clmin,chmaxt1,clmint1,cclsmax,cclsmax1,cclsmaxt1,cclsmin,cclsmin1,cclsmint1,cclsmaxt,cclsmint,co0,ctxt0]            = f_main_process(tf_ok,tf_ok_V, val_ses,xo0,xc0,xh0,xl0,xt0,false,"",arr_sesy,arr_sesz,1)
[dhmaxt,dlmint,dhmax2,dlmin2,dhmax1,dlmin1,dhmax,dlmin,dhmaxt1,dlmint1,dclsmax,dclsmax1,dclsmaxt1,dclsmin,dclsmin1,dclsmint1,dclsmaxt,dclsmint,do0,dtxt0]            = f_main_process(tf_ok,tf_ok_V, val_ses,yo0,yc0,yh0,yl0,yt0,false,"",arr_sesy,arr_sesz,1)

[hmaxDt,lminDt,hmax2D,lmin2D,hmax1D,lmin1D,hmaxD,lminD,hmaxt1D,lmint1D,clsmaxD,clsmax1D,clsmaxt1D,clsminD,clsmin1D,clsmint1D,clsmaxtD,clsmintD,o0D,txt0D]                     = f_main_process(tf_okD,tf_okD_V, val_sesD,open,close,high,low,time,show_candlesD,"Daily",arr_sesDy,arr_sesDz,2)
[chmaxDt,clminDt,chmax2D,clmin2D,chmax1D,clmin1D,chmaxD,clminD,chmaxt1D,clmint1D,cclsmaxD,cclsmax1D,cclsmaxt1D,cclsminD,cclsmin1D,cclsmint1D,cclsmaxtD,cclsmintD,co0D,ctxt0D] = f_main_process(tf_okD,tf_okD_V, val_sesD,xo0,xc0,xh0,xl0,xt0,false,"",arr_sesDy,arr_sesDz,2)
[dhmaxDt,dlminDt,dhmax2D,dlmin2D,dhmax1D,dlmin1D,dhmaxD,dlminD,dhmaxt1D,dlmint1D,dclsmaxD,dclsmax1D,dclsmaxt1D,dclsminD,dclsmin1D,dclsmint1D,dclsmaxtD,dclsmintD,do0D,dtxt0D] = f_main_process(tf_okD,tf_okD_V, val_sesD,yo0,yc0,yh0,yl0,yt0,false,"",arr_sesDy,arr_sesDz,2)

[hmaxWt,lminWt,hmax2W,lmin2W,hmax1W,lmin1W,hmaxW,lminW,hmaxt1W,lmint1W,clsmaxW,clsmax1W,clsmaxt1W,clsminW,clsmin1W,clsmint1W,clsmaxtW,clsmintW,o0W,txt0W]                     = f_main_process(tf_okW,tf_okW_V, val_sesW,open,close,high,low,time,show_candlesW,"Weekly",arr_sesWy,arr_sesWz,3)
[chmaxWt,clminWt,chmax2W,clmin2W,chmax1W,clmin1W,chmaxW,clminW,chmaxt1W,clmint1W,cclsmaxW,cclsmax1W,cclsmaxt1W,cclsminW,cclsmin1W,cclsmint1W,cclsmaxtW,cclsmintW,co0W,ctxt0W] = f_main_process(tf_okW,tf_okW_V, val_sesW,xo0,xc0,xh0,xl0,xt0,false,"",arr_sesWy,arr_sesWz,3)
[dhmaxWt,dlminWt,dhmax2W,dlmin2W,dhmax1W,dlmin1W,dhmaxW,dlminW,dhmaxt1W,dlmint1W,dclsmaxW,dclsmax1W,dclsmaxt1W,dclsminW,dclsmin1W,dclsmint1W,dclsmaxtW,dclsmintW,do0W,dtxt0W] = f_main_process(tf_okW,tf_okW_V, val_sesW,yo0,yc0,yh0,yl0,yt0,false,"",arr_sesWy,arr_sesWz,3)

[hmaxmt,lminmt,hmax2m,lmin2m,hmax1m,lmin1m,hmaxm,lminm,hmaxt1m,lmint1m,clsmaxm,clsmax1m,clsmaxt1m,clsminm,clsmin1m,clsmint1m,clsmaxtm,clsmintm,o0m,txt0m]                     = f_main_process(tf_ok_mic,tf_ok_mic_V, val_sesm,open,close,high,low,time,show_candlesmic ,"Micro",arr_sesmy,arr_sesmz,0)
[chmaxmt,clminmt,chmax2m,clmin2m,chmax1m,clmin1m,chmaxm,clminm,chmaxt1m,clmint1m,cclsmaxm,cclsmax1m,cclsmaxt1m,cclsminm,cclsmin1m,cclsmint1m,cclsmaxtm,cclsmintm,co0m,ctxt0m] = f_main_process(tf_ok_mic,tf_ok_mic_V, val_sesm,xo0,xc0,xh0,xl0,xt0,false,"",arr_sesmy,arr_sesmz,0)
[dhmaxmt,dlminmt,dhmax2m,dlmin2m,dhmax1m,dlmin1m,dhmaxm,dlminm,dhmaxt1m,dlmint1m,dclsmaxm,dclsmax1m,dclsmaxt1m,dclsminm,dclsmin1m,dclsmint1m,dclsmaxtm,dclsmintm,do0m,dtxt0m] = f_main_process(tf_ok_mic,tf_ok_mic_V, val_sesm,yo0,yc0,yh0,yl0,yt0,false,"",arr_sesmy,arr_sesmz,0)

/////////////////////////////////////////////////////////////////////////////SMT 
f_ssmt(ah2,ah1,ah0,al2,al1,al0,bh2,bh1,bh0,bl2,bl1,bl0,start,show,_hmaxt,_lmint,_hmaxt1,_lmint1,_tfok,_val_ses,showon,_smt_clr,tri,xx,zh0,zl0,_tf_ok_V)=>
    _bear1 = ((ah2 >= ah1 and bh2 <= bh1) or (ah2 <= ah1 and bh2 >= bh1) ) and not(ah2 == ah1 and bh2 == bh1) 
    _bear0 = ((ah1 >= ah0 and bh1 <= bh0) or (ah1 <= ah0 and bh1 >= bh0) ) and not(ah1 == ah0 and bh1 == bh0) 
    _bull1 = ((al2 <= al1 and bl2 >= bl1) or (al2 >= al1 and bl2 <= bl1) ) and not(al2 == al1 and bl2 == bl1) 
    _bull0 = ((al1 <= al0 and bl1 >= bl0) or (al1 >= al0 and bl1 <= bl0) ) and not(al1 == al0 and bl1 == bl0)

    var smth1 = line.new(na,na,na,na)
    var smth0 = line.new(na,na,na,na)
    var smtl1 = line.new(na,na,na,na)
    var smtl0 = line.new(na,na,na,na)
    line.delete(smth1)
    line.delete(smth0), 
    line.delete(smtl1)
    line.delete(smtl0)

    if _bear1 and show and _tf_ok_V
        smth1 := line.new(bar_index+start+dx+10,ah2,bar_index+start+dx+13,ah1,color=_smt_clr,width = 2)
    if _bear0 and show and _tf_ok_V
        smth0 := line.new(bar_index+start+dx+13,ah1,bar_index+start+dx+16,ah0,color=_smt_clr,width = 2)
    if _bull1 and show and _tf_ok_V
        smtl1 := line.new(bar_index+start+dx+10,al2,bar_index+start+dx+13,al1,color=_smt_clr,width = 2)
    if _bull0 and show and _tf_ok_V
        smtl0 := line.new(bar_index+start+dx+13,al1,bar_index+start+dx+16,al0,color=_smt_clr,width = 2)

    var smtbeh = line.new(na,na,na,na)
    var smtbul = line.new(na,na,na,na) 
    var smtbe  = label.new(na,na)
    var smtbu  = label.new(na,na)  

    var arr_beh = array.new_line()
    var arr_ch1 = array.new_float()
    var arr_lbh = array.new_label()

    var arr_bul = array.new_line()
    var arr_cl1 = array.new_float()
    var arr_lbl = array.new_label()    

    if (_bull0 or _bear0 )and showon and _tfok and _tf_ok_V
        if _bear0             
            smtbeh := line.new(x1 = _hmaxt1 , y1 = ah1 , x2 = _hmaxt , y2 = ah0 , xloc=xloc.bar_time,color= hidelines ?color.new(_smt_clr,100):_smt_clr,width = 1,style=normstyle) 
            add_to_array_box(arr_beh,smtbeh) 
        if _bull0 
            smtbul := line.new(x1 = _lmint1 , y1 = al1 , x2 = _lmint , y2 = al0 , xloc=xloc.bar_time,color= hidelines ?color.new(_smt_clr,100):_smt_clr,width = 1,style = normstyle)
            add_to_array_box(arr_bul,smtbul)


    if array.size(arr_beh) > 0 and showon and _tfok and _tf_ok_V
        for i = array.size(arr_beh) -1 to 0
            dline = array.get(arr_beh,i)
            top    = line.get_y2(dline)
            tme    = line.get_x2(dline)
            if time > tme and high >= top
                line.delete(dline)
                array.remove(arr_beh,i)
        
    if array.size(arr_bul) > 0 and showon and _tfok and _tf_ok_V
        for i = array.size(arr_bul) -1 to 0
            dline = array.get(arr_bul,i)
            bot    = line.get_y2(dline)
            tme    = line.get_x2(dline)
            if time > tme and low <= bot
                line.delete(dline)
                array.remove(arr_bul,i) 

    [_bear1,_bear0,_bull1,_bull0]

////////////////////////////////////////////////////////////////
f_hidden_ssmt(_clsmax,_clsmax1,_clsmin,_clsmin1,_clsmaxt,_clsmaxt1,_clsmint,_clsmint1,_cclsmax,_cclsmax1,_cclsmin,_cclsmin1,
 _tfok,showon,_smt_clr,tri,xx,_val_ses, ah1 ,ah0, al1,al0,bh1,bh0,bl1,bl0,zh0,zl0 , _tf_ok_V)=>
    _hbear0 = ( (_clsmax >= _clsmax1 and _cclsmax <= _cclsmax1) or (_clsmax <= _clsmax1 and _cclsmax >= _cclsmax1) ) and 
     not (_clsmax == _clsmax1 and _cclsmax == _cclsmax1) //and barstate.isconfirmed
    _lbull0 = ( (_clsmin >= _clsmin1 and _cclsmin <= _cclsmin1) or (_clsmin <= _clsmin1 and _cclsmin >= _cclsmin1) ) and 
     not (_clsmin == _clsmin1 and _cclsmin == _cclsmin1) //and barstate.isconfirmed
     
    var hsmtbeh = line.new(na,na,na,na)
    var hsmtbul = line.new(na,na,na,na) 

    var arr_beh = array.new_line()

    var arr_bul = array.new_line()

    if showon and _tfok and _tf_ok_V
        if _hbear0             
            hsmtbeh := line.new(x1 = _clsmaxt1 , y1 = _clsmax1 , x2 = _clsmaxt , y2 = _clsmax , xloc=xloc.bar_time,color= hidelines ?color.new(_smt_clr,100):_smt_clr,width = 1,style=hiddstyle) 
            add_to_array_box(arr_beh,hsmtbeh)
            
        if _lbull0 
            hsmtbul := line.new(x1 = _clsmint1 , y1 = _clsmin1 , x2 = _clsmint , y2 = _clsmin , xloc=xloc.bar_time,color= hidelines ?color.new(_smt_clr,100):_smt_clr,width = 1,style = hiddstyle)
            add_to_array_box(arr_bul,hsmtbul)


    if array.size(arr_beh) > 0 and showon and _tfok and _tf_ok_V
        for i = array.size(arr_beh) -1 to 0
            dline = array.get(arr_beh,i)
            top    = line.get_y2(dline)
            tme    = line.get_x2(dline)
            if time > tme and math.max(open,close) >= top
                line.delete(dline)
                array.remove(arr_beh,i)
        
    if array.size(arr_bul) > 0 and showon and _tfok and _tf_ok_V
        for i = array.size(arr_bul) -1 to 0
            dline = array.get(arr_bul,i)
            bot    = line.get_y2(dline)
            tme    = line.get_x2(dline)
            if time > tme and math.min(open,close) <= bot
                line.delete(dline)
                array.remove(arr_bul,i)

    [_hbear0,_lbull0]
////////////////////////////////////////////////////////////////

W_SSMT = array.from(false,false,false,false,false,false,false,false,false,false)//0-5 smt1// 6-9 smt2
D_SSMT = array.from(false,false,false,false,false,false,false,false,false,false)
N_SSMT = array.from(false,false,false,false,false,false,false,false,false,false)
m_SSMT = array.from(false,false,false,false,false,false,false,false,false,false)

//////////////////////////////////////////////////////////////////////////////////////////////////////////
//////////////////////////////////////////////////////////////////////////////////////////////////////////
if  alerttype != "Hidden"
    [bear1W,bear0W,bull1W,bull0W] = f_ssmt(hmax2W,hmax1W,hmaxW,lmin2W,lmin1W,lminW,
     chmax2W,chmax1W,chmaxW,clmin2W,clmin1W,clminW,array.get(arrstart,3),show_candlesW,
     hmaxWt,lminWt,hmaxt1W,lmint1W,tf_okW,val_sesW,show_smtW, smtW_clr,false,4,xh0,xl0 , tf_okW_V)//
    array.set(W_SSMT,0,bear1W)
    array.set(W_SSMT,1,bear0W)    
    array.set(W_SSMT,2,bull1W)
    array.set(W_SSMT,3,bull0W)
    if tf_okW  //and tf_okW_V
        ssmt_label := bear0W ? ssmt_label + "W Normal Bearish SSMT "+ ssmt_pair + '\n' : ssmt_label
        ssmt_label := bull0W ? ssmt_label + "W Normal Bullish SSMT "+ ssmt_pair + '\n' : ssmt_label


if alerttype != "Normal"
    [hidbear2W,hidbull2W] = f_hidden_ssmt(clsmaxW,clsmax1W,clsminW,clsmin1W,clsmaxtW,clsmaxt1W,
     clsmintW,clsmint1W,cclsmaxW,cclsmax1W,cclsminW,cclsmin1W,tf_okW,show_hsmtW,smtW_clr,false,4,
     val_sesW, hmax1W ,hmaxW, lmin1W,lminW,chmax1W,chmaxW,clmin1W,clminW,xh0,xl0 , tf_okW_V)
    array.set(W_SSMT,4,hidbear2W)
    array.set(W_SSMT,5,hidbull2W)
    if tf_okW  //and tf_okW_V   
        ssmt_label := hidbear2W ? ssmt_label + "W Hidden Bearish SSMT "+ ssmt_pair + '\n' : ssmt_label
        ssmt_label := hidbull2W ? ssmt_label + "W Hidden Bullish SSMT "+ ssmt_pair + '\n' : ssmt_label


////////////////////////////////////////////////////////////////////////////////////////////////

if alerttype != "Hidden"
    [bear1D,bear0D,bull1D,bull0D] = f_ssmt(hmax2D,hmax1D,hmaxD,lmin2D,lmin1D,lminD,
     chmax2D,chmax1D,chmaxD,clmin2D,clmin1D,clminD,array.get(arrstart,2),show_candlesD,
     hmaxDt,lminDt,hmaxt1D,lmint1D,tf_okD,val_sesD,show_smtD, smtD_clr,false,3,xh0,xl0 , tf_okD_V)//
    array.set(D_SSMT,0,bear1D)
    array.set(D_SSMT,1,bear0D)    
    array.set(D_SSMT,2,bull1D)
    array.set(D_SSMT,3,bull0D)
    if tf_okD //and tf_okD_V
        ssmt_label := bear0D ? ssmt_label + "D Normal Bearish SSMT "+ ssmt_pair + '\n' : ssmt_label
        ssmt_label := bull0D ? ssmt_label + "D Normal Bullish SSMT "+ ssmt_pair + '\n' : ssmt_label

if tf_okD and alerttype != "Normal"
    [hidbear2D,hidbull2D] = f_hidden_ssmt(clsmaxD,clsmax1D,clsminD,clsmin1D,clsmaxtD,clsmaxt1D,
     clsmintD,clsmint1D,cclsmaxD,cclsmax1D,cclsminD,cclsmin1D,tf_okD,show_hsmtD,smtD_clr,false,3,
     val_sesD, hmax1D ,hmaxD, lmin1D,lminD,chmax1D,chmaxD,clmin1D,clminD,xh0,xl0 , tf_okD_V)
    array.set(D_SSMT,4,hidbear2D)
    array.set(D_SSMT,5,hidbull2D)
    if tf_okD  // and tf_okD_V  
        ssmt_label := hidbear2D ? ssmt_label + "D Hidden Bearish SSMT "+ ssmt_pair + '\n' : ssmt_label
        ssmt_label := hidbull2D ? ssmt_label + "D Hidden Bullish SSMT "+ ssmt_pair + '\n' : ssmt_label

//////////////////////////////////////////////////////////////////////////////////////////////////////
if alerttype != "Hidden"
    [bear1,bear0,bull1,bull0] = f_ssmt(hmax2,hmax1,hmax,lmin2,lmin1,lmin,
     chmax2,chmax1,chmax,clmin2,clmin1,clmin,array.get(arrstart,1),show_candles90,
     hmaxt,lmint,hmaxt1,lmint1,tf_ok,val_ses,show_smtN, smt_clr,false,2,xh0,xl0 , tf_ok_V)//
    array.set(N_SSMT,0,bear1)
    array.set(N_SSMT,1,bear0)    
    array.set(N_SSMT,2,bull1)
    array.set(N_SSMT,3,bull0)
    if tf_ok //and tf_ok_V
        ssmt_label := bear0 ? ssmt_label + "90m Normal Bearish SSMT "+ ssmt_pair + '\n' : ssmt_label
        ssmt_label := bull0 ? ssmt_label + "90m Normal Bullish SSMT "+ ssmt_pair + '\n' : ssmt_label

if alerttype != "Normal"
    [hidbear2,hidbull2] = f_hidden_ssmt(clsmax,clsmax1,clsmin,clsmin1,clsmaxt,clsmaxt1,
     clsmint,clsmint1,cclsmax,cclsmax1,cclsmin,cclsmin1,tf_ok,show_hsmtN,smt_clr,false,2,
     val_ses, hmax1 ,hmax, lmin1,lmin,chmax1,chmax,clmin1,clmin,xh0,xl0 , tf_ok_V)
    array.set(N_SSMT,4,hidbear2)
    array.set(N_SSMT,5,hidbull2)
    if tf_ok  //and tf_ok_V   
        ssmt_label := hidbear2 ? ssmt_label + "90m Hidden Bearish SSMT "+ ssmt_pair + '\n' : ssmt_label
        ssmt_label := hidbull2 ? ssmt_label + "90m Hidden Bullish SSMT "+ ssmt_pair + '\n' : ssmt_label

    
///////////////////////////////////////////////////////////////////////////////////////////////////
if alerttype != "Hidden"
    [bear1m,bear0m,bull1m,bull0m] = f_ssmt(hmax2m,hmax1m,hmaxm,lmin2m,lmin1m,lminm,
     chmax2m,chmax1m,chmaxm,clmin2m,clmin1m,clminm,array.get(arrstart,0),show_candlesmic,
     hmaxmt,lminmt,hmaxt1m,lmint1m,tf_ok_mic,val_sesm,show_smtm, smtm_clr,false,1,xh0,xl0 , tf_ok_mic_V)//
    array.set(m_SSMT,0,bear1m)
    array.set(m_SSMT,1,bear0m)    
    array.set(m_SSMT,2,bull1m)
    array.set(m_SSMT,3,bull0m)
    if tf_ok_mic //and tf_ok_mic_V   
        ssmt_label := bear0m ? ssmt_label + "Micro Normal Bearish SSMT "+ ssmt_pair + '\n' : ssmt_label
        ssmt_label := bull0m ? ssmt_label + "Micro Normal Bullish SSMT "+ ssmt_pair + '\n' : ssmt_label

if alerttype != "Normal"
    [hidbear2m,hidbull2m] = f_hidden_ssmt(clsmaxm,clsmax1m,clsminm,clsmin1m,clsmaxtm,clsmaxt1m,
     clsmintm,clsmint1m,cclsmaxm,cclsmax1m,cclsminm,cclsmin1m,tf_ok_mic,show_hsmtm,smtm_clr,false,1,
     val_sesm, hmax1m ,hmaxm, lmin1m,lminm,chmax1m,chmaxm,clmin1m,clminm,xh0,xl0 , tf_ok_mic_V)
    array.set(m_SSMT,4,hidbear2m)
    array.set(m_SSMT,5,hidbull2m)
    if tf_ok_mic  //and tf_ok_mic_V   
        ssmt_label := hidbear2m ? ssmt_label + "Micro Hidden Bearish SSMT "+ ssmt_pair + '\n' : ssmt_label
        ssmt_label := hidbull2m ? ssmt_label + "Micro Hidden Bullish SSMT "+ ssmt_pair + '\n' : ssmt_label


/////////////////////////////////////////////////////////////////////////////////////////////////////////

//////////////////////////////////////////////////////////////////////////////////////////////////////////
ssmt_pair2 = str.tostring(syminfo.ticker(tsym3))
if triad_ok and showsmt2 
    if alerttype != "Hidden"
        [bear1W3,bear0W3,bull1W3,bull0W3] = f_ssmt(hmax2W,hmax1W,hmaxW,lmin2W,lmin1W,lminW,
         dhmax2W,dhmax1W,dhmaxW,dlmin2W,dlmin1W,dlminW,array.get(arrstart,3),show_candlesW,
         hmaxWt,lminWt,hmaxt1W,lmint1W,tf_okW,val_sesW,show_smtW, smtW_clr,true,4,yh0,yl0 , tf_okW_V)//
        if bear0W3
            array.set(W_SSMT,6,bear0W3)            
        if bull0W3
            array.set(W_SSMT,7,bull0W3)
        if tf_okW //and tf_okW_V 
            ssmt_label := bear0W3 ? ssmt_label + "W Normal Bearish SSMT "+ ssmt_pair2 + '\n' : ssmt_label
            ssmt_label := bull0W3 ? ssmt_label + "W Normal Bullish SSMT "+ ssmt_pair2 + '\n' : ssmt_label

    if alerttype != "Normal"          
        [hidbear3W,hidbull3W] = f_hidden_ssmt(clsmaxW,clsmax1W,clsminW,clsmin1W,clsmaxtW,clsmaxt1W,
         clsmintW,clsmint1W,dclsmaxW,dclsmax1W,dclsminW,dclsmin1W,tf_okW,show_hsmtW,smtW_clr,true,4,
         val_sesW, hmax1W ,hmaxW, lmin1W,lminW,dhmax1W,dhmaxW,dlmin1W,dlminW,yh0,yl0 , tf_okW_V) 
        if hidbear3W
            array.set(W_SSMT,8,true)            
        if hidbull3W
            array.set(W_SSMT,9,true)
        if tf_okW  //and tf_okW_V    
            ssmt_label := hidbear3W ? ssmt_label + "W Hidden Bearish SSMT "+ ssmt_pair2+ '\n' : ssmt_label
            ssmt_label := hidbull3W ? ssmt_label + "W Hidden Bullish SSMT "+ ssmt_pair2+ '\n' : ssmt_label



if triad_ok and showsmt2 
    if alerttype != "Hidden"
        [bear1D3,bear0D3,bull1D3,bull0D3] = f_ssmt(hmax2D,hmax1D,hmaxD,lmin2D,lmin1D,lminD,
         dhmax2D,dhmax1D,dhmaxD,dlmin2D,dlmin1D,dlminD,array.get(arrstart,2),show_candlesD,
         hmaxDt,lminDt,hmaxt1D,lmint1D,tf_okD,val_sesD,show_smtD, smtD_clr,true,3,yh0,yl0 , tf_okD_V)//
        if bear0D3
            array.set(D_SSMT,6,bear0D3)            
        if bull0D3
            array.set(D_SSMT,7,bull0D3)
        if tf_okD //and tf_okD_V
            ssmt_label := bear0D3 ? ssmt_label + "D Normal Bearish SSMT "+ ssmt_pair2 + '\n' : ssmt_label
            ssmt_label := bull0D3 ? ssmt_label + "D Normal Bullish SSMT "+ ssmt_pair2 + '\n' : ssmt_label

 
    if alerttype != "Normal"             
        [hidbear3D,hidbull3D] = f_hidden_ssmt(clsmaxD,clsmax1D,clsminD,clsmin1D,clsmaxtD,clsmaxt1D,
         clsmintD,clsmint1D,dclsmaxD,dclsmax1D,dclsminD,dclsmin1D,tf_okD,show_hsmtD,smtD_clr,true,3,
         val_sesD, hmax1D ,hmaxD, lmin1D,lminD,dhmax1D,dhmaxD,dlmin1D,dlminD,yh0,yl0 , tf_okD_V)
        if hidbear3D
            array.set(D_SSMT,8,true)            
        if hidbull3D
            array.set(D_SSMT,9,true)
        if tf_okD  //and tf_okD_V            
            ssmt_label := hidbear3D ? ssmt_label + "D Hidden Bearish SSMT "+ ssmt_pair2+ '\n' : ssmt_label
            ssmt_label := hidbull3D ? ssmt_label + "D Hidden Bullish SSMT "+ ssmt_pair2+ '\n' : ssmt_label


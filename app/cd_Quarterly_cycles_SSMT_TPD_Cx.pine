    if tf0_bear_tpd and (high[1] == hmax or high[1] == hmaxD or high[1] == hmaxW) and high < high[1]
        lb0bear = label.new(time[1], low[1],text="X" , xloc=xloc.bar_time,yloc=yloc.abovebar,color=color.new(color.gray,100),size= size.tiny,textcolor = bear_clr)



if show_table
    table.cell(tablo,0,0,text="cd_Quarterly Cycles & SSMT &TPD_Cx",text_color=color.white,bgcolor= i_main_clr, text_size = ii_font,text_formatting = text.format_bold)//
    table.cell(tablo,0,1,text=str.tostring(ssmt_label) ,text_color=i_textcolor,bgcolor= i_bgcolor, text_size = ii_font,text_formatting = text.format_bold)



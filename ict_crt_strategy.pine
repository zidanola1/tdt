//@version=5
strategy("ICT/CRT Core Scaffold – Time · Structure · Liquidity",
    overlay=true,
    initial_capital=100000,
    calc_on_every_tick=true,
    calc_on_order_fills=true,
    pyramiding=0,
    max_labels_count=500,
    max_lines_count=500,
    max_bars_back=5000,
    process_orders_on_close=true,
    commission_type=strategy.commission.percent,
    commission_value=0.01)

//=====================================================
// Inputs – Time, Structure, Liquidity, Risk
//=====================================================
useSession       = input.bool(true, "Use Session Filter")
sessionStr       = input.session("0930-1600", "Session (exchange time)")
maxTradesDay     = input.int(3, "Max Trades per Day", 0, 20)

allowLongs       = input.bool(true, "Allow Longs")
allowShorts      = input.bool(true, "Allow Shorts")

// Bias / Trend filter (HTF)
higherTF         = input.timeframe("240", "Bias Timeframe")
emaFastLen       = input.int(21, "Trend EMA Fast", 1)
emaSlowLen       = input.int(50, "Trend EMA Slow", 1)

// Momentum guardrail
useRSIFilter     = input.bool(true, "Use RSI Filter")
rsiLen           = input.int(14, "RSI Length", 1)
rsiOB            = input.int(70, "RSI Overbought", 50, 100)
rsiOS            = input.int(30, "RSI Oversold", 0, 50)

// Liquidity mechanics
useLiquidity     = input.bool(true, "Require Liquidity Sweep")
swingLen         = input.int(5, "Swing Length", 1, 50)
lookbackBars     = input.int(30, "Sweep Lookback Bars", 5, 300)

// FVG / Pattern toggles
useFVG           = input.bool(false, "Require Fair Value Gap (context)")
fvgLookback      = input.int(15, "FVG Lookback Bars", 3, 300)
enableTurtleSoup = input.bool(true, "Enable Turtle Soup Model")
enableCRT        = input.bool(true, "Enable Three Candle CRT Model")

// Risk and targets
stopType         = input.string("ATR", "Stop Type", options=["ATR", "Swing"])
atrLen           = input.int(14, "ATR Length", 1)
atrMult          = input.float(2.0, "ATR Stop Mult", 0.1, 10.0)

riskPct          = input.float(1.0, "Risk % per Trade", 0.1, 5.0)
targetMode       = input.string("RR", "Target Mode", options=["RR", "Structure"])
tpRR1            = input.float(1.0, "TP1 RR", 0.2, 10.0, inline="rr")
tpRR2            = input.float(2.0, "TP2 RR", 0.2, 20.0, inline="rr")
tpRR3            = input.float(3.0, "TP3 RR", 0.2, 30.0, inline="rr")
rangeSource      = input.string("Auto", "Structure Range Source", options=["Auto", "Asian", "Monday", "Swing"])
usePartials      = input.bool(true, "Use Partials (33/33/34)")

plotSignals      = input.bool(true, "Plot Signals/Levels")

// MSS + OTE
useMSSOTE        = input.bool(true, "Use Market Structure Shift + OTE")
oteLow           = input.float(0.5, "OTE Low (Fib)", 0.0, 1.0)
oteHigh          = input.float(0.886, "OTE High (Fib)", 0.0, 1.0)

// Session Models
useAsianRange    = input.bool(true, "Use Asian Range (20:00-00:00 NY)")
asianSessionStr  = input.session("2000-0000", "Asian Session (exchange time)")
useMondayRange   = input.bool(true, "Use Monday Range Model")

// Kill Zones
useKillZones     = input.bool(true, "Filter by Kill Zones")
londonSessionStr = input.session("0300-0600", "London Kill Zone")
newyorkSessionStr= input.session("0930-1130", "New York Kill Zone")

// SMT Divergence
useSMT           = input.bool(false, "Use SMT Divergence Filter")
smtSymbol        = input.symbol("SPY", "SMT Reference Symbol")
smtLookback      = input.int(50, "SMT Lookback Bars", 5, 1000)

//=====================================================
// Utilities – Sessions, Bias, Momentum
//=====================================================
inSession = not useSession or time(timeframe.period, sessionStr)

emaFastHTF = request.security(syminfo.tickerid, higherTF, ta.ema(close, emaFastLen), barmerge.gaps_on, barmerge.lookahead_off)
emaSlowHTF = request.security(syminfo.tickerid, higherTF, ta.ema(close, emaSlowLen), barmerge.gaps_on, barmerge.lookahead_off)
trendLong  = emaFastHTF > emaSlowHTF
trendShort = emaFastHTF < emaSlowHTF

rsi = ta.rsi(close, rsiLen)
rsiOkLong  = not useRSIFilter or rsi <= rsiOB
rsiOkShort = not useRSIFilter or rsi >= rsiOS

//=====================================================
// Liquidity Pools – Swing Points and Sweeps
//=====================================================
// Fractal swing points
swingHigh = ta.pivothigh(high, swingLen, swingLen)
swingLow  = ta.pivotlow(low,  swingLen, swingLen)

// Track most recent swing levels within a lookback window
var float recentHigh = na
var float recentLow  = na

recentHigh := not na(swingHigh) ? swingHigh : (bar_index - ta.valuewhen(not na(swingHigh), bar_index, 0) <= lookbackBars ? nz(recentHigh, high) : na)
recentLow  := not na(swingLow)  ? swingLow  : (bar_index - ta.valuewhen(not na(swingLow),  bar_index, 0) <= lookbackBars ? nz(recentLow, low)  : na)

// Sweep: wick through prior H/L then close back within
sweepHigh = useLiquidity and not na(recentHigh) and high > recentHigh and close < recentHigh
sweepLow  = useLiquidity and not na(recentLow)  and low  < recentLow  and close > recentLow

//=====================================================
// Fair Value Gaps (simple 3-candle logic) and tracking
//=====================================================
bullFVG = low[1] > high[2]
bearFVG = high[1] < low[2]

bullFVGSeen = useFVG ? ta.barssince(bullFVG) <= fvgLookback : true
bearFVGSeen = useFVG ? ta.barssince(bearFVG) <= fvgLookback : true

//=====================================================
// Market Structure Shift (MSS) + OTE
//=====================================================
// Simple structure: HH/HL for bullish, LL/LH for bearish
hh = high > ta.highest(high, 5)[1]
ll = low  < ta.lowest(low,  5)[1]

// MSS as a displacement after taking prior swing
mssBull = useMSSOTE and hh and sweepLow
mssBear = useMSSOTE and ll and sweepHigh

// OTE retracement window after impulse: measure last leg
var float legHigh = na
var float legLow  = na
if mssBull
    legHigh := high
    legLow  := nz(ta.lowest(low, 10), low)
else if mssBear
    legLow  := low
    legHigh := nz(ta.highest(high, 10), high)

fibLoBull = legLow + (legHigh - legLow) * oteLow
fibHiBull = legLow + (legHigh - legLow) * oteHigh
fibLoBear = legHigh - (legHigh - legLow) * oteHigh
fibHiBear = legHigh - (legHigh - legLow) * oteLow

oteOkLong  = useMSSOTE ? (not na(legHigh) and not na(legLow) and close >= fibLoBull and close <= fibHiBull) : true
oteOkShort = useMSSOTE ? (not na(legHigh) and not na(legLow) and close <= fibHiBear and close >= fibLoBear) : true

//=====================================================
// Session Ranges – Asian and Monday
//=====================================================
asianActive = useAsianRange and time(timeframe.period, asianSessionStr)

var float asianHigh = na
var float asianLow  = na
if asianActive and na(asianHigh)
    asianHigh := high
    asianLow  := low
else if asianActive
    asianHigh := math.max(asianHigh, high)
    asianLow  := math.min(asianLow,  low)
else if not asianActive
    asianHigh := na
    asianLow  := na

// Monday range (use first D bar of week)
isMonday = dayofweek == dayofweek.monday
var float mondayHigh = na
var float mondayLow  = na
newWeek = ta.change(weekofyear(time))
if newWeek
    mondayHigh := na
    mondayLow  := na
if useMondayRange and isMonday
    mondayHigh := na(mondayHigh) ? high : math.max(mondayHigh, high)
    mondayLow  := na(mondayLow)  ? low  : math.min(mondayLow,  low)

//=====================================================
// Structure Range selection and targets (50% / 100%)
//=====================================================
// Auto preference: Monday > Asian > Swing
var float rangeHigh = na
var float rangeLow  = na

// Swing proxy: last detected recentHigh/recentLow
swHigh = recentHigh
swLow  = recentLow

if targetMode == "Structure"
    if (rangeSource == "Monday" or (rangeSource == "Auto" and not na(mondayHigh) and not na(mondayLow)))
        rangeHigh := mondayHigh
        rangeLow  := mondayLow
    else if (rangeSource == "Asian" or (rangeSource == "Auto" and not na(asianHigh) and not na(asianLow)))
        rangeHigh := asianHigh
        rangeLow  := asianLow
    else
        rangeHigh := swHigh
        rangeLow  := swLow

midpoint   = not na(rangeHigh) and not na(rangeLow) ? (rangeHigh + rangeLow) / 2.0 : na
tpLong1ST  = midpoint
tpLong2ST  = rangeHigh
tpLong3ST  = rangeHigh
tpShort1ST = midpoint
tpShort2ST = rangeLow
tpShort3ST = rangeLow

// Final target selection by mode
tpLong1  = targetMode == "Structure" ? tpLong1ST  : tpLong1RR
tpLong2  = targetMode == "Structure" ? tpLong2ST  : tpLong2RR
tpLong3  = targetMode == "Structure" ? tpLong3ST  : tpLong3RR
tpShort1 = targetMode == "Structure" ? tpShort1ST : tpShort1RR
tpShort2 = targetMode == "Structure" ? tpShort2ST : tpShort2RR
tpShort3 = targetMode == "Structure" ? tpShort3ST : tpShort3RR

//=====================================================
// Daily Trade Counter
//=====================================================
var int dayTrades = 0
newDay = ta.change(time("D"))
if newDay
    dayTrades := 0

canTradeToday = maxTradesDay == 0 or dayTrades < maxTradesDay

//=====================================================
// Entry Placeholders – to be expanded with CRT/Turtle Soup/OTE
//=====================================================
// Turtle Soup primitives: take old low/high then reverse
tsLong  = enableTurtleSoup and sweepLow
tsShort = enableTurtleSoup and sweepHigh

// Three Candle Model (CRT): C1 accumulation, C2 manipulation, C3 distribution
// Simple proxy: bullish CRT when C2 makes a lower low than C1 and C3 closes above C1 close
crtBull = enableCRT and bar_index > 2 and low[1] < low[2] and close > close[2]
crtBear = enableCRT and bar_index > 2 and high[1] > high[2] and close < close[2]

// Combine context filters
killZoneOk = not useKillZones or time(timeframe.period, londonSessionStr) or time(timeframe.period, newyorkSessionStr)

asianBreakLong  = useAsianRange  and not na(asianHigh) and high > asianHigh
asianBreakShort = useAsianRange  and not na(asianLow)  and low  < asianLow

mondayBreakLong  = useMondayRange and not na(mondayHigh) and high > mondayHigh
mondayBreakShort = useMondayRange and not na(mondayLow)  and low  < mondayLow

sessionOkLong  = (not useAsianRange or asianBreakLong)  and (not useMondayRange or mondayBreakLong)
sessionOkShort = (not useAsianRange or asianBreakShort) and (not useMondayRange or mondayBreakShort)

longSetup  = inSession and canTradeToday and allowLongs  and trendLong  and rsiOkLong  and (not useLiquidity or sweepLow)  and bullFVGSeen  and (tsLong or crtBull or not (enableTurtleSoup or enableCRT)) and oteOkLong  and killZoneOk and sessionOkLong
shortSetup = inSession and canTradeToday and allowShorts and trendShort and rsiOkShort and (not useLiquidity or sweepHigh) and bearFVGSeen and (tsShort or crtBear or not (enableTurtleSoup or enableCRT)) and oteOkShort and killZoneOk and sessionOkShort

//=====================================================
// Risk – Stops, Position Sizing, Targets
//=====================================================
atr = ta.atr(atrLen)

// Long stop
longStopATR   = close - atrMult * atr
longStopSwing = nz(ta.lowest(low, swingLen), low)
longStop      = stopType == "ATR" ? longStopATR : longStopSwing

// Short stop
shortStopATR   = close + atrMult * atr
shortStopSwing = nz(ta.highest(high, swingLen), high)
shortStop      = stopType == "ATR" ? shortStopATR : shortStopSwing

// Risk unit and qty
stopDistLong  = math.max(close - longStop, syminfo.mintick)
stopDistShort = math.max(shortStop - close, syminfo.mintick)

equity   = nz(strategy.equity, strategy.initial_capital)
riskCash = equity * (riskPct / 100.0)

qtyLong  = riskCash / stopDistLong
qtyShort = riskCash / stopDistShort

// Targets by RR
tpLong1RR  = close + tpRR1 * stopDistLong
tpLong2RR  = close + tpRR2 * stopDistLong
tpLong3RR  = close + tpRR3 * stopDistLong

tpShort1RR = close - tpRR1 * stopDistShort
tpShort2RR = close - tpRR2 * stopDistShort
tpShort3RR = close - tpRR3 * stopDistShort

//=====================================================
// Orders – With optional partials
//=====================================================
enterLong  = longSetup  and not strategy.position_size > 0 and not strategy.position_size < 0
enterShort = shortSetup and not strategy.position_size < 0 and not strategy.position_size > 0

if enterLong
    // In structure mode, bias to two legs (TP1 midpoint, TP2 opposite side)
    if usePartials
        q1 = qtyLong * 0.33
        q2 = qtyLong * 0.33
        q3 = qtyLong - q1 - q2
        strategy.entry("Long", strategy.long, qty=q1)
        strategy.exit("L-TP1", from_entry="Long", limit=tpLong1, stop=longStop, qty_percent=100)
        strategy.order("Long2_enter", strategy.long, qty=(targetMode == "Structure" ? (q2+q3) : q2))
        strategy.exit("L-TP2", from_entry="Long2_enter", limit=tpLong2, stop=longStop, qty_percent=100)
        if targetMode != "Structure"
            strategy.order("Long3_enter", strategy.long, qty=q3)
            strategy.exit("L-TP3", from_entry="Long3_enter", limit=tpLong3, stop=longStop, qty_percent=100)
    else
        strategy.entry("Long", strategy.long, qty=qtyLong)
        strategy.exit("L-EXIT", from_entry="Long", limit=tpLong2, stop=longStop)
    dayTrades += 1

if enterShort
    if usePartials
        q1s = qtyShort * 0.33
        q2s = qtyShort * 0.33
        q3s = qtyShort - q1s - q2s
        strategy.entry("Short", strategy.short, qty=q1s)
        strategy.exit("S-TP1", from_entry="Short", limit=tpShort1, stop=shortStop, qty_percent=100)
        strategy.order("Short2_enter", strategy.short, qty=(targetMode == "Structure" ? (q2s+q3s) : q2s))
        strategy.exit("S-TP2", from_entry="Short2_enter", limit=tpShort2, stop=shortStop, qty_percent=100)
        if targetMode != "Structure"
            strategy.order("Short3_enter", strategy.short, qty=q3s)
            strategy.exit("S-TP3", from_entry="Short3_enter", limit=tpShort3, stop=shortStop, qty_percent=100)
    else
        strategy.entry("Short", strategy.short, qty=qtyShort)
        strategy.exit("S-EXIT", from_entry="Short", limit=tpShort2, stop=shortStop)
    dayTrades += 1

//=====================================================
// Alerts
//=====================================================
alertcondition(enterLong,  title="Enter Long",  message="Enter Long")
alertcondition(enterShort, title="Enter Short", message="Enter Short")

//=====================================================
// Plotting – Bias, Pools, Sweeps, Sessions
//=====================================================
plot(plotSignals ? emaFastHTF : na, "HTF EMA Fast", color=color.new(color.green, 0))
plot(plotSignals ? emaSlowHTF : na, "HTF EMA Slow", color=color.new(color.red, 0))

plot(plotSignals and not na(recentHigh) ? recentHigh : na, "Recent High", color=color.new(color.red, 70), style=plot.style_linebr)
plot(plotSignals and not na(recentLow)  ? recentLow  : na, "Recent Low",  color=color.new(color.green, 70), style=plot.style_linebr)

plotshape(plotSignals and sweepLow,  title="Sweep Low",  style=shape.triangleup,   color=color.new(color.green, 0), size=size.tiny, location=location.belowbar, text="SWL")
plotshape(plotSignals and sweepHigh, title="Sweep High", style=shape.triangledown, color=color.new(color.red, 0),   size=size.tiny, location=location.abovebar, text="SWH")

// Plot Asian/Monday ranges
plot(plotSignals and not na(asianHigh)  ? asianHigh  : na, "Asian High",  color=color.new(color.teal, 70), style=plot.style_linebr)
plot(plotSignals and not na(asianLow)   ? asianLow   : na, "Asian Low",   color=color.new(color.teal, 70), style=plot.style_linebr)
plot(plotSignals and not na(mondayHigh) ? mondayHigh : na, "Monday High", color=color.new(color.orange, 70), style=plot.style_linebr)
plot(plotSignals and not na(mondayLow)  ? mondayLow  : na, "Monday Low",  color=color.new(color.orange, 70), style=plot.style_linebr)

bgcolor(useSession and not inSession ? color.new(color.gray, 90) : na)

//=====================================================
// SMT Divergence (optional) – simple high/low confirmation mismatch
//=====================================================
refClose = useSMT ? request.security(smtSymbol, timeframe.period, close, barmerge.gaps_on, barmerge.lookahead_off) : na
refHigh  = useSMT ? request.security(smtSymbol, timeframe.period, high,  barmerge.gaps_on, barmerge.lookahead_off) : na
refLow   = useSMT ? request.security(smtSymbol, timeframe.period, low,   barmerge.gaps_on, barmerge.lookahead_off) : na

makeHigherHigh(series) => series > ta.highest(series, 10)[1]
makeLowerLow(series)  => series < ta.lowest(series,  10)[1]

priHH = makeHigherHigh(high)
priLL = makeLowerLow(low)
refHH = useSMT ? makeHigherHigh(refHigh) : false
refLL = useSMT ? makeLowerLow(refLow)  : false

smtBull = useSMT and priLL and not refLL
smtBear = useSMT and priHH and not refHH

// Require SMT only if enabled
longSetup  := longSetup  and (not useSMT or smtBull)
shortSetup := shortSetup and (not useSMT or smtBear)

// Visualize structure midpoint and targets when enabled
plot(plotSignals and targetMode == "Structure" and not na(midpoint)  ? midpoint  : na, "Range Mid (50%)", color=color.new(color.yellow, 0), style=plot.style_circles)
plot(plotSignals and targetMode == "Structure" and not na(rangeHigh) ? rangeHigh : na, "Range High (100%)", color=color.new(color.lime, 0), style=plot.style_linebr)
plot(plotSignals and targetMode == "Structure" and not na(rangeLow)  ? rangeLow  : na, "Range Low (0%)",   color=color.new(color.red, 0),  style=plot.style_linebr)

